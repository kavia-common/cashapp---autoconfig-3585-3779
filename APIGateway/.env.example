# Application
APP_NAME=CashApp API Gateway
APP_VERSION=1.0.0
APP_DESCRIPTION=Central API Gateway for CashApp

# CORS (comma separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-frontend.app

# Backend base URL
BACKEND_BASE_URL=http://apigateway-backend:8000

# OAuth2 / JWT
OAUTH2_SECRET_KEY=CHANGE_ME
OAUTH2_ALGORITHM=HS256
OAUTH2_ACCESS_TOKEN_EXPIRE_MINUTES=30
OAUTH2_TOKEN_URL=/auth/token
OAUTH2_ISSUER=cashapp-gateway
OAUTH2_AUDIENCE=cashapp-clients

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Public site URL for redirects (optional)
SITE_URL=https://your.app.url
